# Copy to private/secrets.env (never commit). Reserved for future
# service tokens or dashboard credentials.
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
# NAS credentials stay in the existing PowerShell SAN config, not here.
# NAS_USER=
# NAS_PASSWORD=
# Optional Uptime Kuma auth. Prefer a public status-page slug in
# private/services.yaml (heartbeat JSON). KUMA_API_KEY is only needed
# if you fall back to Prometheus GET /metrics (Basic auth, empty username).
# KUMA_API_KEY=
# KUMA_USERNAME=
# KUMA_PASSWORD=
# KUMA_COOKIE=
